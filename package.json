{
  "name": "claude-patrol",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "claude-patrol": "./bin/claude-patrol.js"
  },
  "scripts": {
    "setup:xterm": "bash scripts/setup-xterm.sh",
    "setup": "bash scripts/setup.sh",
    "build": "pnpm --filter claude-patrol-frontend build",
    "start": "bash scripts/build-if-stale.sh && bash scripts/start-loop.sh",
    "watch": "bash scripts/build-if-stale.sh && node src/watch.js",
    "lint": "biome check .",
    "typecheck": "tsc --project frontend/tsconfig.json",
    "test:backend": "node --test --import ./src/test-support/isolate-home.js 'src/**/*.test.js'",
    "test:frontend": "pnpm --filter claude-patrol-frontend test",
    "test": "pnpm run test:backend && pnpm run test:frontend"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.1",
    "node-pty": "^1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
